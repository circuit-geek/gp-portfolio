<section id="contact" class="section">
  <div class="container">
    <div class="cta reveal">
      <div class="glow" aria-hidden="true"></div>
      <span class="eyebrow">Contact</span>
      <h2 class="section-title">Let's build something <em>useful</em>.</h2>
      <p>
        I'm happy to talk about data science and backend roles, collaborations, or just machine learning and maths.
        The inbox is the quickest way to reach me.
      </p>
      <div class="row">
        <a class="btn btn-primary" href="mailto:gpece2001@gmail.com">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
          gpece2001@gmail.com
        </a>
        <a class="btn btn-ghost" href="https://www.linkedin.com/in/gaurav-prasanna-12400b191/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="btn btn-ghost" href="https://github.com/circuit-geek" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    padding: clamp(2.5rem, 6vw, 5rem);
    text-align: center;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: 28px;
    box-shadow: var(--shadow-md);
  }

  .glow {
    position: absolute;
    inset: -40% -10% auto;
    height: 80%;
    background: radial-gradient(closest-side, var(--accent-soft), transparent);
    z-index: 0;
    animation: pulse 8s ease-in-out infinite alternate;
  }

  @keyframes pulse {
    to {
      transform: scale(1.15);
      opacity: 0.6;
    }
  }

  .cta > :not(.glow) {
    position: relative;
    z-index: 1;
  }

  .eyebrow {
    justify-content: center;
  }

  .cta p {
    max-width: 52ch;
    margin: 0 auto 2rem;
    font-size: 1.08rem;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
</style>
