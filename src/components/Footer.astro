---
import { url } from '../utils/url';
---

<footer class="footer">
  <div class="container inner">
    <p>&copy; {new Date().getFullYear()} Gaurav Prasanna</p>
    <nav aria-label="Footer">
      <a href={url('#experience')}>Experience</a>
      <a href={url('#projects')}>Projects</a>
      <a href={url('blog/')}>Blog</a>
      <a href="https://github.com/circuit-geek" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="https://www.linkedin.com/in/gaurav-prasanna-12400b191/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding: 2rem 0;
  }

  .inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  p {
    font-size: 0.88rem;
    color: var(--ink-3);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  nav a {
    font-size: 0.88rem;
    color: var(--ink-2);
    transition: color 0.2s;
  }

  nav a:hover {
    color: var(--accent);
  }
</style>
