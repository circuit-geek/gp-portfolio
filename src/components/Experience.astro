---
import { experience } from '../data/experience';

const trackLabel = { 'data-science': 'Data Science', backend: 'Backend', both: 'Data Science + Backend' } as const;
---

<section id="experience" class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Experience</span>
      <h2 class="section-title">Work across the <em>whole stack</em> of an AI product.</h2>
      <p class="section-lede">
        From model development to the APIs that serve it, for industrial and enterprise clients.
      </p>
      <div class="legend">
        <span><i class="dot data-science"></i> Data Science</span>
        <span><i class="dot backend"></i> Backend</span>
        <span><i class="dot both"></i> Both</span>
      </div>
    </div>

    <div class="timeline">
      {
        experience.map((role) => (
          <div class="role">
            <div class="role-head reveal">
              <div>
                <h3>{role.role}</h3>
                <p class="company">
                  {role.company} <span>· {role.location}</span>
                </p>
              </div>
              <span class:list={['period', { current: role.current }]}>{role.period}</span>
            </div>

            <div class="items">
              {role.items.map((item, i) => (
                <article class="card item reveal" style={`--d:${(i % 2) * 90}ms`}>
                  <div class="item-top">
                    <span class="client">
                      <i class={`dot ${item.track}`} />
                      {item.client}
                    </span>
                    <span class="track">{trackLabel[item.track]}</span>
                  </div>
                  <h4>{item.title}</h4>
                  <p>{item.summary}</p>
                  {item.metric && (
                    <div class="metric">
                      <strong>{item.metric.value}</strong>
                      <span>{item.metric.label}</span>
                    </div>
                  )}
                  <div class="stack">
                    {item.stack.map((s) => (
                      <span class="chip">{s}</span>
                    ))}
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: var(--ink-2);
  }

  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .legend i,
  .client i {
    font-style: normal;
  }

  .timeline {
    position: relative;
    display: grid;
    gap: 3.5rem;
    padding-left: 2rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5rem;
    bottom: 0;
    width: 1px;
    background: linear-gradient(var(--ds), var(--be) 70%, transparent);
  }

  .role {
    position: relative;
  }

  .role::before {
    content: '';
    position: absolute;
    left: calc(-2rem - 5px);
    top: 0.55rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }

  .role-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-bottom: 1.5rem;
  }

  .role-head h3 {
    font-size: 1.5rem;
  }

  .company {
    color: var(--ink);
    font-weight: 500;
  }

  .company span {
    color: var(--ink-3);
    font-weight: 400;
  }

  .period {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    color: var(--ink-2);
  }

  .period.current {
    color: var(--be);
    border-color: color-mix(in srgb, var(--be) 45%, transparent);
    background: color-mix(in srgb, var(--be) 10%, transparent);
  }

  .items {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.1rem;
  }

  .item {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
  }

  .item-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.9rem;
  }

  .client {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    color: var(--ink-2);
  }

  .track {
    font-size: 0.72rem;
    color: var(--ink-3);
  }

  .item h4 {
    font-size: 1.15rem;
    margin-bottom: 0.6rem;
  }

  .item p {
    font-size: 0.95rem;
    margin-bottom: 1.1rem;
  }

  .metric {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    padding: 0.8rem 1rem;
    margin-bottom: 1.1rem;
    background: var(--accent-soft);
    border-radius: 12px;
  }

  .metric strong {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 2rem;
    line-height: 1;
    color: var(--accent);
  }

  .metric span {
    font-size: 0.82rem;
    color: var(--ink-2);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }

  @media (max-width: 820px) {
    .items {
      grid-template-columns: 1fr;
    }

    .timeline {
      padding-left: 1.4rem;
    }

    .role::before {
      left: calc(-1.4rem - 5px);
    }
  }
</style>
