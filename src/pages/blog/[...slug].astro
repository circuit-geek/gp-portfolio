---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { url } from '../../utils/url';
import { readingTime } from '../../utils/reading-time';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  return posts.map((post, i) => ({
    params: { slug: post.slug },
    props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  newer: CollectionEntry<'blog'> | null;
  older: CollectionEntry<'blog'> | null;
}

const { post, newer, older } = Astro.props;
const { Content } = await post.render();
const date = post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout title={`${post.data.title} · Gaurav Prasanna`} description={post.data.description}>
  <Navigation />

  <main class="post-page">
    <article class="container narrow">
      <a href={url('blog/')} class="back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>
        All posts
      </a>

      <header class="header">
        <div class="meta">
          <time datetime={post.data.pubDate.toISOString()}>{date}</time>
          <span>·</span>
          <span>{readingTime(post.body ?? '')} min read</span>
        </div>
        <h1>{post.data.title}</h1>
        <p class="desc">{post.data.description}</p>
        {
          post.data.tags && (
            <div class="chips">
              {post.data.tags.map((t) => (
                <span class="chip">{t}</span>
              ))}
            </div>
          )
        }
      </header>

      <div class="prose">
        <Content />
      </div>

      <nav class="pager" aria-label="More posts">
        {
          newer ? (
            <a class="card" href={url(`blog/${newer.slug}/`)}>
              <span>Newer</span>
              <strong>{newer.data.title}</strong>
            </a>
          ) : (
            <span />
          )
        }
        {
          older && (
            <a class="card next" href={url(`blog/${older.slug}/`)}>
              <span>Older</span>
              <strong>{older.data.title}</strong>
            </a>
          )
        }
      </nav>
    </article>
  </main>

  <Footer />
</Layout>

<style>
  .post-page {
    padding: 8rem 0 5rem;
  }

  .narrow {
    max-width: 760px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
    font-size: 0.9rem;
    color: var(--ink-2);
    transition: color 0.2s, transform 0.3s var(--ease);
  }

  .back:hover {
    color: var(--accent);
    transform: translateX(-3px);
  }

  .header {
    margin-bottom: 3rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--line);
    animation: rise 0.9s var(--ease) both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  .meta {
    display: flex;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-3);
    margin-bottom: 1rem;
  }

  h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2.4rem, 6vw, 3.8rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .desc {
    font-size: 1.2rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* Markdown body */
  .prose {
    font-size: 1.08rem;
    line-height: 1.8;
    color: var(--ink);
  }

  .prose :global(> :first-child) {
    margin-top: 0;
  }

  /* The first "# Introduction" heading in posts is redundant under the title */
  .prose :global(h1) {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 2.1rem;
    margin: 2.8rem 0 1rem;
  }

  .prose :global(h2) {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.9rem;
    margin: 2.8rem 0 1rem;
  }

  .prose :global(h3) {
    font-size: 1.3rem;
    margin: 2.2rem 0 0.8rem;
  }

  .prose :global(p) {
    font-size: inherit;
    color: var(--ink);
    opacity: 0.88;
    margin-bottom: 1.4rem;
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.4rem 1.4rem;
    color: var(--ink);
    opacity: 0.88;
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
  }

  .prose :global(blockquote) {
    margin: 1.8rem 0;
    padding: 0.2rem 0 0.2rem 1.3rem;
    border-left: 3px solid var(--accent);
    color: var(--ink-2);
    font-style: italic;
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 3rem 0;
  }

  .prose :global(img) {
    margin: 2rem auto;
    border-radius: 12px;
    border: 1px solid var(--line);
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 0.15em 0.4em;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .prose :global(pre) {
    margin: 1.8rem 0;
    padding: 1.2rem 1.4rem;
    overflow-x: auto;
    font-size: 0.88rem;
    line-height: 1.65;
    background: var(--code-bg) !important;
    border: 1px solid var(--line);
    border-radius: 14px;
  }

  .prose :global(pre code) {
    padding: 0;
    background: none;
    border: 0;
    font-size: inherit;
  }

  :global(:root[data-theme='dark']) .prose :global(.astro-code),
  :global(:root[data-theme='dark']) .prose :global(.astro-code span) {
    color: var(--shiki-dark) !important;
  }

  .prose :global(table) {
    width: 100%;
    margin: 1.8rem 0;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.6rem 0.8rem;
    text-align: left;
    border-bottom: 1px solid var(--line);
  }

  .prose :global(.katex-display) {
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.5rem 0;
  }

  /* Prev / next */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--line);
  }

  .pager a {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.2rem 1.4rem;
  }

  .pager span {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .pager .next {
    grid-column: 2;
    text-align: right;
  }

  @media (max-width: 600px) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager .next {
      grid-column: 1;
    }
  }
</style>
