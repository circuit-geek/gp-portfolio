---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { url } from '../../utils/url';
import { readingTime } from '../../utils/reading-time';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Layout title="Blog · Gaurav Prasanna" description="Writing on statistics, maths, machine learning and tech by Gaurav Prasanna.">
  <Navigation />

  <main class="blog">
    <div class="container">
      <header class="head">
        <span class="eyebrow rise" style="--i:0">Blog</span>
        <h1 class="rise" style="--i:1">Notes on <em>maths</em>, statistics and machine learning.</h1>
        <p class="rise" style="--i:2">
          I write to understand things properly. Expect derivations, code and the occasional detour into cinema.
        </p>
      </header>


      <div class="list">
        {
          posts.map((post, i) => (
            <a
              class="card post reveal"
              href={url(`blog/${post.slug}/`)}
              style={`--d:${(i % 3) * 80}ms`}
            >
              <div class="meta">
                <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
                <span>·</span>
                <span>{readingTime(post.body ?? '')} min read</span>
              </div>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <div class="foot">
                <div class="chips">
                  {(post.data.tags ?? []).map((t) => (
                    <span class="chip">{t}</span>
                  ))}
                </div>
                <span class="more">
                  Read
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                </span>
              </div>
            </a>
          ))
        }
      </div>

      {posts.length === 0 && <p class="empty">First posts are on their way.</p>}
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .blog {
    padding: 9rem 0 5rem;
    min-height: 80vh;
  }

  .rise {
    animation: rise 0.9s var(--ease) both;
    animation-delay: calc(var(--i) * 100ms + 80ms);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  .head {
    max-width: 720px;
    margin-bottom: 2.5rem;
  }

  h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  h1 em {
    font-style: italic;
    color: var(--accent);
  }

  .head p {
    font-size: 1.1rem;
  }

  .list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.1rem;
  }

  .post {
    display: flex;
    flex-direction: column;
    padding: 1.8rem;
  }

  .meta {
    display: flex;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-3);
    margin-bottom: 0.9rem;
  }

  .post h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.8rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: 0.7rem;
    transition: color 0.2s;
  }

  .post:hover h2 {
    color: var(--accent);
  }

  .post p {
    font-size: 0.98rem;
    margin-bottom: 1.5rem;
    max-width: 62ch;
  }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--ink);
  }

  .more svg {
    transition: transform 0.3s var(--ease);
  }

  .post:hover .more svg {
    transform: translateX(4px);
  }

  .empty {
    padding: 3rem 0;
    text-align: center;
  }

  @media (max-width: 760px) {
    .list {
      grid-template-columns: 1fr;
    }
  }
</style>

